{
  "editor.formatOnSave": false,
  "editor.rulers": [100],
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "javascript.preferences.importModuleSpecifierEnding": "js",
  "javascript.validate.enable": true,
  "search.exclude": {
    "dist": true,
    "node_modules": true
  },
  "files.associations": {
    "manifest.json": "jsonc"
  }
}
